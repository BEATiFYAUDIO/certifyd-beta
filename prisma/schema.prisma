generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ParticipantStatus {
  INVITED
  ACCEPTED
  INSTALLING
  ACTIVE
  COMPLETED
  STALLED
  DECLINED
  ARCHIVED
}

enum InviteStatus {
  CREATED
  OPENED
  ACCEPTED
  EXPIRED
  REVOKED
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
  BLOCKED
  SKIPPED
}

enum ParticipantMissionStatus {
  ASSIGNED
  ACTIVE
  BLOCKED
  COMPLETED
  SKIPPED
  ARCHIVED
}

model Mission {
  id               String               @id @default(cuid())
  name             String
  slug             String               @unique
  sequence         Int                  @default(0)
  shortDescription String
  inviteCopy       String
  active           Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  milestones       MissionMilestone[]
  assignments      ParticipantMission[]

  @@index([sequence])
}

model MissionMilestone {
  id          String                        @id @default(cuid())
  missionId   String
  title       String
  description String                        @default("")
  sortOrder   Int
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt
  mission     Mission                       @relation(fields: [missionId], references: [id], onDelete: Cascade)
  progress    ParticipantMissionProgress[]

  @@index([missionId, sortOrder])
}

model Participant {
  id                         String               @id @default(cuid())
  publicCode                 String               @unique
  name                       String
  email                      String               @unique
  organizationOrProject      String               @default("")
  roleDescription            String               @default("")
  profileUrl                 String               @default("")
  aiAgent                    String               @default("")
  operatingSystem            String               @default("")
  status                     ParticipantStatus    @default(INVITED)
  networkOriginParticipantId String?
  parentParticipantId        String?
  createdAt                  DateTime             @default(now())
  acceptedAt                 DateTime?
  completedAt                DateTime?
  updatedAt                  DateTime             @updatedAt
  parentParticipant          Participant?         @relation("ParticipantTree", fields: [parentParticipantId], references: [id], onDelete: SetNull)
  downstreamParticipants     Participant[]        @relation("ParticipantTree")
  networkOriginParticipant   Participant?         @relation("NetworkOrigin", fields: [networkOriginParticipantId], references: [id], onDelete: SetNull)
  networkMembers             Participant[]        @relation("NetworkOrigin")
  invites                    Invite[]
  assignments                ParticipantMission[]
  notes                      FounderNote[]

  @@index([status])
  @@index([parentParticipantId])
  @@index([networkOriginParticipantId])
}

model ParticipantMission {
  id            String                       @id @default(cuid())
  participantId String
  missionId     String
  status        ParticipantMissionStatus     @default(ASSIGNED)
  sequence      Int
  assignedAt    DateTime                     @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  participant   Participant                  @relation(fields: [participantId], references: [id], onDelete: Cascade)
  mission       Mission                      @relation(fields: [missionId], references: [id], onDelete: Restrict)
  progress      ParticipantMissionProgress[]
  invites       Invite[]
  notes         FounderNote[]

  @@unique([participantId, missionId])
  @@index([participantId, status])
  @@index([participantId, sequence])
  @@index([missionId])
}

model Invite {
  id                      String              @id @default(cuid())
  code                    String              @unique
  codeHash                String              @unique
  codePreview             String
  participantId           String
  participantMissionId    String?
  status                  InviteStatus        @default(CREATED)
  published               Boolean             @default(false)
  publishedAt             DateTime?
  createdAt               DateTime            @default(now())
  openedAt                DateTime?
  acceptedAt              DateTime?
  expiresAt               DateTime?
  lastOpenedAt            DateTime?
  openCount               Int                 @default(0)
  participant             Participant         @relation(fields: [participantId], references: [id], onDelete: Cascade)
  participantMission      ParticipantMission? @relation(fields: [participantMissionId], references: [id], onDelete: SetNull)

  @@index([participantId])
  @@index([participantMissionId])
  @@index([status])
  @@index([published])
}

model ParticipantMissionProgress {
  id                    String             @id @default(cuid())
  participantMissionId  String
  milestoneId           String
  status                MilestoneStatus    @default(NOT_STARTED)
  note                  String             @default("")
  completedAt           DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  participantMission    ParticipantMission @relation(fields: [participantMissionId], references: [id], onDelete: Cascade)
  milestone             MissionMilestone   @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@unique([participantMissionId, milestoneId])
  @@index([participantMissionId])
}

model FounderNote {
  id                      String              @id @default(cuid())
  participantId           String
  participantMissionId    String?
  body                    String
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  participant             Participant         @relation(fields: [participantId], references: [id], onDelete: Cascade)
  participantMission      ParticipantMission? @relation(fields: [participantMissionId], references: [id], onDelete: SetNull)

  @@index([participantId, createdAt])
  @@index([participantMissionId, createdAt])
}

model AuditEvent {
  id            String   @id @default(cuid())
  actor         String
  action        String
  participantId String?
  metadata      String   @default("{}")
  createdAt     DateTime @default(now())

  @@index([participantId])
  @@index([createdAt])
}

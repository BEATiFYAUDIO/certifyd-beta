# PostgreSQL is required for normal development and production.
DATABASE_URL="postgresql://certifyd_beta:replace-me@localhost:5432/certifyd_beta"

# Single-admin MVP credentials. ADMIN_PASSWORD may be plaintext locally or a bcrypt hash.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-long-unique-password"

# At least 32 random characters. Use a generated secret in production.
SESSION_PASSWORD="replace-with-at-least-32-random-characters"

# Public response email used by generated static Accept/Decline mailto links.
BETA_CONTACT_EMAIL="beta-contact@example.com"

# Local admin/preview app URL. This is not the published invite URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Published static invite origin used by Public URL and Copy Public URL.
PUBLIC_SITE_ORIGIN="https://beta.certifyd.me"
NODE_ENV="development"
